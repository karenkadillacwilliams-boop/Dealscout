# Copy contents into Streamlit Cloud: app settings -> Secrets.
# Locally, Dealscout still loads from .env via python-dotenv; this file is
# only consumed when running on Streamlit Community Cloud.

# Turso (replaces local dealscout.db)
TURSO_DATABASE_URL = "libsql://your-db-name.turso.io"
TURSO_AUTH_TOKEN = "eyJhbGciOi..."

# Data providers
POLYGON_API_KEY = "your-polygon-api-key"
SEC_USER_AGENT = "Dealscout/1.0 you@example.com"
ANTHROPIC_API_KEY = "sk-ant-..."
MAX_RERANK_CALLS_PER_DAY = "200"

# Alert channels (optional — leave empty strings to disable)
GMAIL_USER = ""
GMAIL_APP_PW = ""
ALERT_TO_EMAIL = ""
DISCORD_WEBHOOK_URL = ""
